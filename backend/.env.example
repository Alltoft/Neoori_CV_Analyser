FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# mysql+pymysql://user:password@host:3306/neoori
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/neoori

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
RESEND_API_KEY=re_...
MAIL_FROM=neoori <bonjour@neoori.tech>
APP_URL=http://localhost:8080
# « Continuer avec Google / Microsoft »: a button shows only once both of its
# provider's keys are set. How to create them:
# docs/superpowers/specs/2026-10-03-social-login-design.md, appendices A and B.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Model routing — swap strings to change provider, no code changes needed
MODEL_FREE=gemini/gemini-2.5-flash
MODEL_PAID=anthropic/claude-sonnet-4-6

FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5001