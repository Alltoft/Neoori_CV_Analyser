# =====================================================================
# neoori production environment (VPS). Copy beside docker-compose.prod.yml:
#   cp .env.example .env      # then fill in REAL values
# NEVER commit the real .env.
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate a Fernet field-encryption key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================

# ---- MySQL (host/db/user are fixed in compose: db / neoori / neoori) ----
# Stick to letters+digits: the password is embedded in DATABASE_URL and
# special characters would need URL-encoding.
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_PASSWORD=CHANGE_ME_strong_app_password

# ---- Flask secrets (required in production) ----
SECRET_KEY=CHANGE_ME_64_char_random
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_64_char_random
# Comma-separated Fernet keys, newest first (see app/utils/crypto.py).
# Unset = derived from SECRET_KEY (works, but rotating SECRET_KEY then loses
# encrypted profile data — set it explicitly in production).
FIELD_ENCRYPTION_KEYS=

# ---- AI providers ----
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# Model routing (litellm strings) — swap without code changes
MODEL_FREE=gemini/gemini-2.5-flash
MODEL_PAID=anthropic/claude-sonnet-4-6
# Testing override: "paid" forces every analysis to the paid tier (current PM
# review mode). LEAVE EMPTY in production for real free/paid routing.
FORCE_ANALYSIS_TIER=

# ---- Email ----
RESEND_API_KEY=re_...

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAID_PRICE_EUR_CENTS=900
PREMIUM_PRICE_EUR_CENTS=2400

# ---- URLs / TLS ----
# Public origin of the app (used for CORS allow-list + Stripe return URLs).
FRONTEND_URL=https://app.example.fr
# Bare domain for nginx server_name + Let's Encrypt paths.
DOMAIN=app.example.fr
# http = phase 1 (no cert yet, IP testing, ACME); https = phase 2 (after
# certificate issuance — see DOCKER.md).
NGINX_MODE=http

# ---- Gunicorn tuning ----
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
