# =====================================================================
# neoori production environment (VPS). Copy beside docker-compose.prod.yml:
#   cp .env.example .env      # then fill in REAL values
# NEVER commit the real .env.
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate a Fernet field-encryption key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================

# ---- MySQL (host/db/user are fixed in compose: db / neoori / neoori) ----
# Stick to letters+digits: the password is embedded in DATABASE_URL and
# special characters would need URL-encoding.
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_PASSWORD=CHANGE_ME_strong_app_password

# ---- Flask secrets (required in production) ----
SECRET_KEY=CHANGE_ME_64_char_random
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_64_char_random
# Comma-separated Fernet keys, newest first (see app/utils/crypto.py).
# Unset = derived from SECRET_KEY (works, but rotating SECRET_KEY then loses
# encrypted profile data — set it explicitly in production).
FIELD_ENCRYPTION_KEYS=

# ---- AI providers ----
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# Model routing (litellm strings) — swap without code changes
MODEL_FREE=anthropic/claude-haiku-4-5-20251001
MODEL_PAID=anthropic/claude-sonnet-4-6

# ---- Email ----
RESEND_API_KEY=re_...
# Sender shown to recipients. The domain must be verified in Resend.
MAIL_FROM=neoori <bonjour@neoori.tech>
# Public origin the account mails link to (verification, reset, conseiller).
APP_URL=https://app.example.fr
# Who gets the « Nouvelle demande de compte conseiller » mail, comma-separated.
# Unset, every verified admin does — set it when an admin login has no mailbox.
ADMIN_NOTIFY_EMAIL=

# ---- Sign-in with Google / Microsoft (optional) ----
# A provider's button shows only once both its keys are set. How to create
# them: docs/superpowers/specs/2026-10-03-social-login-design.md, appendices
# A and B. After an edit: docker compose -f docker-compose.prod.yml up -d --force-recreate backend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
# Microsoft secrets expire (24 months at most). Write the expiry date on this
# line when you paste one; renew a month before (DOCKER.md, "Google /
# Microsoft sign-in keys").
MICROSOFT_CLIENT_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAID_PRICE_EUR_CENTS=900
PREMIUM_PRICE_EUR_CENTS=2400

# ---- URLs / TLS ----
# Public origin of the app (used for CORS allow-list + Stripe return URLs).
FRONTEND_URL=https://app.example.fr
# Bare domain for nginx server_name + Let's Encrypt paths.
DOMAIN=app.example.fr
# http = phase 1 (no cert yet, IP testing, ACME); https = phase 2 (after
# certificate issuance — see DOCKER.md).
NGINX_MODE=http

# ---- Gunicorn tuning ----
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300

# Four-doors spec — daily caps, input caps, retentions (defaults shown)
# ANONYMOUS_RUNS_PER_DAY=200
# FREE_RUNS_PER_ACCOUNT_PER_DAY=5
# CV_TEXT_MAX=40000
# CIBLE_MAX=10000
# ANONYMOUS_RETENTION_DAYS=30
# ADVISOR_RETENTION_DAYS=365
# HELD_DRAFT_RETENTION_HOURS=48
# HELD_DRAFTS_MAX=2000
